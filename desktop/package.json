{
  "name": "clara-desktop",
  "productName": "Clara",
  "version": "0.1.0",
  "private": true,
  "description": "Clara desktop — hosts the local engine + model and the plain-language pay/explain dashboard.",
  "main": "dist/main.mjs",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "scripts": {
    "build:main": "node esbuild.main.mjs",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs",
    "build:renderer": "esbuild src/renderer/app.tsx --bundle --format=iife --jsx=automatic --outfile=dist/renderer/app.js",
    "build:html": "node -e \"const fs=require('fs');fs.mkdirSync('dist/renderer/assets',{recursive:true});fs.copyFileSync('src/renderer/index.html','dist/renderer/index.html');for(const f of fs.readdirSync('src/renderer/assets'))fs.copyFileSync('src/renderer/assets/'+f,'dist/renderer/assets/'+f)\"",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer && pnpm build:html",
    "start": "pnpm build && electron .",
    "make": "pnpm build && electron-forge make",
    "make:linux": "pnpm build && electron-forge make --platform=linux --arch=x64",
    "make:win": "pnpm build && electron-forge make --platform=win32 --arch=x64"
  },
  "dependencies": {
    "@clara/engine": "workspace:*",
    "@qvac/sdk": "0.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/plugin-base": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@reforged/maker-appimage": "^5.0.0"
  }
}
